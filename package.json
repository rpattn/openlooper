{
  "name": "openlooper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm run lint && npm run build",
    "routing:prepare": "bash scripts/prepare-routing-data.sh",
    "routing:up": "docker compose -f docker/valhalla/compose.yaml up -d",
    "routing:down": "docker compose -f docker/valhalla/compose.yaml down",
    "routing:logs": "docker compose -f docker/valhalla/compose.yaml logs -f",
    "evidence:prepare": "bash scripts/prepare-evidence-data.sh",
    "evidence:up": "docker compose -f docker/evidence/compose.yaml up -d",
    "evidence:down": "docker compose -f docker/evidence/compose.yaml down",
    "evidence:logs": "docker compose -f docker/evidence/compose.yaml logs -f",
    "region:prepare": "npm run routing:prepare && npm run evidence:prepare"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
